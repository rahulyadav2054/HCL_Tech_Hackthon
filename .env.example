# Copy to .env and fill in. Never commit .env.

# Grok (xAI) API key. Without a key the pipeline uses the offline extractive generator.
GROK_API_KEY=

# Optional overrides
# LLM_MODEL=grok-4-fast-non-reasoning     # run `python -m ai.llm --check` to list models your key can use
# LLM_BASE_URL=https://api.x.ai/v1         # a Groq key (gsk_...) switches to https://api.groq.com/openai/v1 automatically
# LLM_PROVIDER=grok                        # or "offline" to force the extractive generator
# LLM_MAX_TOKENS=800
# LLM_CACHE=1                              # cache LLM outputs (demo survives API outages); 0 to disable
# PII_ENGINE=presidio                      # or "regex" (faster, no spaCy)
# API_URL=http://localhost:8000            # where the Streamlit UI finds the API

# Authentication (JWT)
# JWT_SECRET signs login tokens: generate one with `python -m backend.auth --generate-secret`.
JWT_SECRET=
# JWT_EXPIRE_MINUTES=60
# Initial password for analyst1, analyst2 and admin1 (demo only). Change per user with
# `python -m backend.auth --set-password <user>`.
DEMO_PASSWORD=
